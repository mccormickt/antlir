[cells]
    root = .
    prelude = prelude
    toolchains = toolchains
    none = none

[cell_aliases]
    config = prelude
    fbsource = none
    fbcode = none

[external_cells]
    prelude = bundled

[parser]
    target_platform_detector_spec = target:root//...->prelude//platforms:default

[build]
    execution_platforms = root//:host

[buck2]
    file_watcher = notify
